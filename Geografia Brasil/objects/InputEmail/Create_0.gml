// Variáveis para o gerenciamento de texto
globalvar text;
text = "";
max_length = 28; // Tamanho máximo do texto
cursor_position = 0;
caret_timer = 0; // Temporizador para o cursor de piscar
caret_blink_time = 30; // Tempo entre piscadas do cursor
caret_visible = true; // Visibilidade do cursor
global.clicked = false;
